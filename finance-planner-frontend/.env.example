# ===========================================
# Finance Planner Frontend - Environment Configuration
# ===========================================
# Copy this file to .env.local for local development
# Vite automatically loads .env files based on mode
# ===========================================

# -------------------------------------------
# API Configuration
# -------------------------------------------
# Backend API base URL
VITE_API_BASE_URL=http://localhost:8080

# API request timeout (milliseconds)
VITE_API_TIMEOUT=30000

# -------------------------------------------
# Application Configuration
# -------------------------------------------
# Application title
VITE_APP_TITLE=Come Rich - AI Financial Planner

# Application version (auto-injected from package.json in production)
VITE_APP_VERSION=1.0.0

# -------------------------------------------
# Feature Flags
# -------------------------------------------
# Enable/disable OCR feature
VITE_FEATURE_OCR_ENABLED=true

# Enable/disable AI chat feature
VITE_FEATURE_AI_CHAT_ENABLED=true

# Enable/disable investment feature
VITE_FEATURE_INVESTMENT_ENABLED=true

# -------------------------------------------
# Third-party Services
# -------------------------------------------
# Analytics tracking ID (optional)
# VITE_ANALYTICS_ID=

# Error tracking DSN (optional)
# VITE_SENTRY_DSN=
