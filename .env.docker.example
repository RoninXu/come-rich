# ===========================================
# Docker Environment Configuration
# ===========================================
# Copy this file to .env.docker for docker-compose usage
# ===========================================

# -------------------------------------------
# PostgreSQL Configuration
# -------------------------------------------
POSTGRES_DB=finance_planner
POSTGRES_USER=finance
POSTGRES_PASSWORD=your_secure_postgres_password_here

# -------------------------------------------
# Redis Configuration
# -------------------------------------------
# Redis password (optional, uncomment if needed)
# REDIS_PASSWORD=your_redis_password_here

# -------------------------------------------
# Application Configuration (for app container)
# -------------------------------------------
# Used when running the full stack via docker-compose

# Database connection (use service name as host)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=finance_planner
DB_USERNAME=finance
DB_PASSWORD=your_secure_postgres_password_here

# Redis connection (use service name as host)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DATABASE=0

# JWT Configuration
JWT_SECRET=your_very_long_and_secure_jwt_secret_key_here_at_least_64_characters
JWT_EXPIRATION=86400000

# AI Provider Keys
DEEPSEEK_API_KEY=your_deepseek_api_key_here
MOONSHOT_API_KEY=your_moonshot_api_key_here
QWEN_API_KEY=your_qwen_api_key_here

# OCR Configuration
BAIDU_OCR_API_KEY=your_baidu_ocr_api_key_here
BAIDU_OCR_SECRET_KEY=your_baidu_ocr_secret_key_here

# Server Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=prod
