# ===========================================
# Come Rich - Environment Configuration
# ===========================================
# Copy this file to .env and fill in actual values
# NEVER commit .env file to version control
# ===========================================

# -------------------------------------------
# Database Configuration
# -------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=finance_planner
DB_USERNAME=finance
DB_PASSWORD=your_secure_password_here

# -------------------------------------------
# Redis Configuration
# -------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DATABASE=0
# REDIS_PASSWORD=your_redis_password_here  # Uncomment if Redis requires authentication

# -------------------------------------------
# JWT Configuration
# -------------------------------------------
# Generate a secure random string (minimum 64 characters for HS512)
JWT_SECRET=your_very_long_and_secure_jwt_secret_key_here_at_least_64_characters
JWT_EXPIRATION=86400000

# -------------------------------------------
# AI Provider Configuration
# -------------------------------------------
# Active provider: deepseek | moonshot | qwen
AI_ACTIVE_PROVIDER=deepseek

# DeepSeek API (https://platform.deepseek.com/)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Moonshot API (https://platform.moonshot.cn/)
MOONSHOT_API_KEY=your_moonshot_api_key_here

# Qwen API (https://dashscope.aliyun.com/)
QWEN_API_KEY=your_qwen_api_key_here

# AI Rate Limiting
AI_DAILY_LIMIT=10

# -------------------------------------------
# Baidu OCR Configuration
# -------------------------------------------
# Get keys from: https://cloud.baidu.com/product/ocr
BAIDU_OCR_API_KEY=your_baidu_ocr_api_key_here
BAIDU_OCR_SECRET_KEY=your_baidu_ocr_secret_key_here

# -------------------------------------------
# Server Configuration
# -------------------------------------------
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# -------------------------------------------
# Logging Configuration
# -------------------------------------------
LOG_LEVEL_APP=DEBUG
LOG_LEVEL_SECURITY=DEBUG
